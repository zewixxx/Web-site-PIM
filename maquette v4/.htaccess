RewriteRule ^(fr|en|de)/[^/]*-(68)\.html$ https://www.pim-industrie.com/pages/luxe/etiquette-plastique.html [R=301,L,NE,QSD]
# ancienne actualité (salon, presse, portes ouvertes) : accueil
RewriteRule ^(fr|en|de)/[^/]*-(54|74|75|76|80|89|90)\.html$ https://www.pim-industrie.com/ [R=301,L,NE,QSD]
# plus de newsletter : accueil
RewriteRule ^(fr|en|de)/[^/]*-(57|63)\.html$ https://www.pim-industrie.com/ [R=301,L,NE,QSD]

# --- Site 2002-2003 (/pages, /uk/pages), anciens points d'entree, filets de securite
RewriteRule ^(uk/)?(index\.htm|flash_fr\.htm|flash_uk\.htm)$ https://www.pim-industrie.com/ [R=301,L,NE,QSD]
RewriteRule ^(uk/)?pages/claviermem?n?bra[mn]e\.htm$ https://www.pim-industrie.com/pages/industrie/claviers/clavier-membrane.html [R=301,L,NE,QSD]
RewriteRule ^(uk/)?pages/contact\.htm$ https://www.pim-industrie.com/pages/contact/contact.html [R=301,L,NE,QSD]
RewriteRule ^(uk/)?pages/faceavantplastique\.htm$ https://www.pim-industrie.com/pages/industrie/face-avant-plastique.html [R=301,L,NE,QSD]
RewriteRule ^(uk/)?pages/metal\.htm$ https://www.pim-industrie.com/pages/industrie/facade-metal.html [R=301,L,NE,QSD]
RewriteRule ^(uk/)?pages/galerie/metal/.*$ https://www.pim-industrie.com/pages/industrie/facade-metal.html [R=301,L,NE,QSD]
RewriteRule ^(uk/)?pages/plan\.htm$ https://www.pim-industrie.com/pages/legal/plan-du-site.html [R=301,L,NE,QSD]
RewriteRule ^(uk/)?pages/(quisommenous\.htm|galerie/qsn/.*)$ https://www.pim-industrie.com/pages/entreprise/a-propos.html [R=301,L,NE,QSD]
RewriteRule ^(uk/)?pages/zoom_carte\.html$ https://www.pim-industrie.com/pages/contact/contact.html#acces [R=301,L,NE,QSD]
# ancien point d'entrée PHP (paramètres supprimés)
RewriteRule ^(index|page|site/page|site/page_[0-9]+)\.php$ https://www.pim-industrie.com/ [R=301,L,NE,QSD]
RewriteRule ^tag\.html$ https://www.pim-industrie.com/ [R=301,L,NE,QSD]
RewriteRule ^site/[a-z]{2}\.cookie\.html$ https://www.pim-industrie.com/pages/legal/confidentialite.html [R=301,L,NE,QSD]
# INCERTAIN : ancien PDF RSE
RewriteRule ^site/rsepdf-fr-5-2\.html$ https://www.pim-industrie.com/pages/entreprise/a-propos.html#engagements [R=301,L,NE,QSD]
RewriteRule ^site/flyer_systemes_plv_lumineuxpdf-fr-15-2\.html$ https://www.pim-industrie.com/pages/luxe/plv-lumineuse.html [R=301,L,NE,QSD]
# filet de sécurité (ancienne page non listée) : À RETIRER quand /en/ ou /de/ seront publiés sur le .com
RewriteRule ^(fr|en|de|uk)(/.*)?$ https://www.pim-industrie.com/ [R=301,L,NE,QSD]

# 3) HTTPS + www.pim-industrie.com (une seule version du site pour Google ;
#    redirige aussi pim-industrie.com, et .fr/.de s'ils pointent sur cet hébergement, en gardant le chemin)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\.pim-industrie\.com$ [NC]
RewriteRule ^ https://www.pim-industrie.com%{REQUEST_URI} [L,R=301]

# 4) /index.html -> /
RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
RewriteRule ^index\.html$ https://www.pim-industrie.com/ [L,R=301]

# 4b) Anciennes adresses à la racine -> page rangée dans son dossier.
