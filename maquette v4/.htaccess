RewriteRule ^(fr|en|de)/[^/]*-(22)\.html$ https://www.pim-industrie.com/pages/industrie/industrie.html [R=301,L,NE,QSD]
RewriteRule ^(fr|en|de)/[^/]*-(70)\.html$ https://www.pim-industrie.com/pages/industrie/industrie.html#domaines [R=301,L,NE,QSD]
