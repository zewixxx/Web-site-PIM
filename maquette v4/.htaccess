# =====================================================================
# .htaccess — www.pim-industrie.com (domaine officiel, site français)
# Serveur Apache 2.4 (OVH). À tester sur une préproduction avant mise en ligne.
# Si la préproduction a un autre nom de domaine, désactiver temporairement la règle 3.
#
# Fichiers : index.html à la racine, pages/ par rubrique, css/, js/, img/.
# L'adresse publique est le chemin du fichier (pages/rubrique/nom.html).
# Les anciennes adresses /nom.html redirigent vers ce chemin (règle 4b).
# =====================================================================
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /pages/systeme/404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# 1) Fichiers de travail jamais publics (ne pas les mettre en ligne de toute façon)
#    Bloque aussi _prive/ (configuration, journaux et données du formulaire de contact).
RewriteRule (^|/)_ - [F,L]
# 1b) Fichiers et dossiers cachés (.git, .env, .user.ini...) jamais publics, sauf /.well-known/ (certificats SSL)
RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]

# 2) Anciennes adresses du site (2002-2025, .com/.fr/.de) -> nouvelles pages, en UNE seule redirection
#    (cible absolue https://www.pim-industrie.com : pas de chaîne http -> https -> nouvelle page).
#    Liste complète reconstituée en 11/2026 (Wayback Machine + sitemap archivé d'août 2025),
#    détail URL par URL dans _outils-dev/redirections-301.csv. 151 règles 301 + 6 règles 410.
#    Aucune règle ne vise une page du nouveau site (vérifié), donc pas de boucle.
#    /en/ et /de/ -> page FR la plus proche, PROVISOIREMENT (pas encore de version EN/DE).
#    Flags : R=301 permanent, L dernière règle, NE garde le #ancre, QSD supprime les anciens ?paramètres (Apache 2.4).
#    [G] = 410 Gone. Aucune URL de spam (piratage) trouvée ; les 410 visent des pages techniques de l'ancien CMS.
# --- 410 Gone : pages techniques de l'ancien CMS, tests, liens sortants (aucune URL de spam trouvée)
# technique : ancien back-office PHP (pas du spam)
RewriteRule ^admin(/|$) - [G]
# technique : script PHP de l'ancien CMS (pas du spam)
RewriteRule ^(sas|site/fichier|medias/.*)\.php$ - [G]
# page de test/attente
RewriteRule ^fr/(test-55|test-1-colonne-56|attente-de-49|attente-UK-50)\.html$ - [G]
# lien sortant (agence web, partenaire)
RewriteRule ^site/(Site|Lien)[-_].*\.html$ - [G]
# lien sortant (article de presse externe)
RewriteRule ^site/Article-Premium-Beauty-News-fr-38-1\.html$ - [G]
# lien sortant (chaîne YouTube)
RewriteRule ^site/Chaine-Youtube-Pim-Industrie-fr-14-1\.html$ - [G]

